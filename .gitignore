
# Spec-driven workflow session files (ephemeral)
spec-driven/.sessions/

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment / secrets (S-1)
.env
.env.*
!.env.example

# Logs
*.log

# OS / editor
.DS_Store

# Local dev overrides - machine-specific, never commit
docker-compose.override.yml

