{
  "name": "@meal-tracking/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build -w @meal-tracking/shared && npm run build -w @meal-tracking/nutrition-engine && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:recipe": "vitest run src/routes/e2e-recipe-nutrition.test.ts src/routes/e2e-usda-degradation.test.ts",
    "e2e:planner": "vitest run src/routes/e2e-plan-a-week.test.ts src/routes/e2e-week-history.test.ts src/routes/e2e-weekly-summary.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@meal-tracking/nutrition-engine": "0.1.0",
    "@meal-tracking/shared": "0.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.31.10",
    "supertest": "7.1.3",
    "tsx": "4.22.3",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
