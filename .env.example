# Environment variable names only. Never commit real secrets (S-1).
# Copy to .env and fill in real values. .env is gitignored; Compose reads these
# at runtime via env_file/environment - never as build ARGs.

# --- Postgres credentials (postgres service; the API DSN is composed from these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mealtracking

# --- API ---
# pino log level (optional, default info): fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Host port to publish the API on (optional, default 8100). The container still
# listens internally on 3000; this is only the published host port.
API_PORT=8100
# Browser origin allowed to call the API cross-origin (AD-5). "*" (default)
# reflects any origin, so it works from localhost, a LAN IP, or a hostname with
# no per-host config; set a specific http(s) URL (e.g. http://localhost:8090) to
# lock it down.
CORS_ORIGIN=*

# --- Web ---
# Base URL the browser uses to reach the API; injected into the SPA at runtime
# (env-config.js). Must point at the API's published HOST port (API_PORT=8100).
# For remote access, replace localhost with the server's host/IP, e.g.
# http://my-server:8100.
API_BASE_URL=http://localhost:8100
# Host port to publish the web SPA on (optional, default 8090). The container
# still listens internally on 8080; this is only the published host port.
WEB_PORT=8090

# --- Running the API directly (outside Compose) ---
# When you run `npm start` in apps/api without Compose, set DATABASE_URL instead;
# Compose composes it from the POSTGRES_* vars above.
# DATABASE_URL=postgres://postgres:changeme@localhost:5432/mealtracking
# PORT=3000
# HOST=0.0.0.0
