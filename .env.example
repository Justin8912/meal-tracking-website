# Environment variable names only. Never commit real secrets (S-1).
# Copy to .env and fill in real values. .env is gitignored; Compose reads these
# at runtime via env_file/environment - never as build ARGs.

# --- Postgres credentials (postgres service; the API DSN is composed from these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mealtracking

# --- API ---
# pino log level (optional, default info): fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Host port to publish the API on (optional, default 3000).
API_PORT=3000
# Browser origin allowed to call the API cross-origin (AD-5). Must match the web
# origin below so the SPA's fetches are not blocked by CORS. Optional, default
# http://localhost:8080.
# Allowed browser origin for the API. "*" (default) reflects any origin; set a
# specific http(s) URL to lock it down.
CORS_ORIGIN=*

# --- Web ---
# Base URL the browser uses to reach the API; injected into the SPA at runtime
# (env-config.js). For local Compose, the host URL the API is published on.
API_BASE_URL=http://localhost:3000
# Host port to publish the web SPA on (optional, default 8080).
WEB_PORT=8080

# --- Running the API directly (outside Compose) ---
# When you run `npm start` in apps/api without Compose, set DATABASE_URL instead;
# Compose composes it from the POSTGRES_* vars above.
# DATABASE_URL=postgres://postgres:changeme@localhost:5432/mealtracking
# PORT=3000
# HOST=0.0.0.0
