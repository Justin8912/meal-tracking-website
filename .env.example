# Environment variable names only. Never commit real secrets (S-1).
# Copy to .env and fill in for local development.

# PostgreSQL connection string (required). Read at API startup from process.env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mealtracking

# API server port (optional, default 3000).
PORT=3000

# API bind host (optional, default 0.0.0.0).
HOST=0.0.0.0

# pino log level (optional, default info).
LOG_LEVEL=info
