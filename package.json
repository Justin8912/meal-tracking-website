{
  "name": "meal-tracking-website",
  "version": "0.1.0",
  "private": true,
  "description": "Meal tracking website monorepo (platform foundation)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.base.json && npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "@types/node": "20.17.10"
  },
  "overrides": {
    "vite": "6.4.2"
  }
}
